# Kaggle API Credentials for automated dataset download
# Obtain these by logging into Kaggle -> Account Settings -> API -> "Create New Token"
# Place the downloaded values here or place kaggle.json in ~/.kaggle/
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# MLflow Experiment Tracking
MLFLOW_EXPERIMENT_NAME=Credit_Card_Fraud_Detection
MLFLOW_TRACKING_URI=./mlruns

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
